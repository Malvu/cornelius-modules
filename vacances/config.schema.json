      "oneOf": [
        {
          "const": "A",
          "title": "Zone A"
        },
        {
          "const": "B",
          "title": "Zone B"
        },
        {
          "const": "C",
          "title": "Zone C"
        },
        {
          "const": "Corse",
          "title": "Corse"
        }
      ]
    },
    "region": {
      "title": "Jours fériés",
