{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PoubellesConfig v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["bacs", "veille"],
  "properties": {
    "bacs": {
      "title": "Bacs ramassés",
      "description": "Un bac par ligne, avec ses jours comme les écrit la commune : « lundi et jeudi », « mercredi semaines paires », « 1er vendredi du mois ».",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bac", "jours"],
        "properties": {
          "bac": {
            "title": "Bac",
            "type": "string",
            "oneOf": [
              { "const": "menager", "title": "Ordures ménagères" },
              { "const": "emballages", "title": "Emballages et papiers" },
              { "const": "verre", "title": "Verre" },
              { "const": "biodechets", "title": "Biodéchets" },
              { "const": "vegetaux", "title": "Déchets verts" },
              { "const": "encombrants", "title": "Encombrants" }
            ]
          },
          "jours": {
            "title": "Jours de ramassage",
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "examples": ["lundi et jeudi"]
          }
        }
      }
    },
    "veille": {
      "title": "Sortir la veille au soir",
      "description": "Le ramassage passe tôt : Cornelius le rappelle dès la veille au soir.",
      "type": "boolean"
    }
  }
}
