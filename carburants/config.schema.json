{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CarburantsConfig v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["stationId", "stationLabel", "fuel"],
  "properties": {
    "stationId": {
      "title": "Station",
      "description": "Cherchez la station par sa commune ou son code postal.",
      "type": "string",
      "pattern": "^[0-9]{5,9}$",
      "maxLength": 9
    },
    "stationLabel": {
      "title": "Nom de la station",
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "fuel": {
      "title": "Carburant principal",
      "description": "Annoncé en premier ; « Tous » : dans l’ordre habituel.",
      "type": ["string", "null"],
      "oneOf": [
        {
          "const": null,
          "title": "Tous"
        },
        {
          "const": "gazole",
          "title": "Gazole"
        },
        {
          "const": "e10",
          "title": "SP95-E10"
        },
        {
          "const": "sp95",
          "title": "SP95"
        },
        {
          "const": "sp98",
          "title": "SP98"
        },
        {
          "const": "e85",
          "title": "E85"
        },
        {
          "const": "gplc",
          "title": "GPL"
        }
      ]
    }
  }
}
